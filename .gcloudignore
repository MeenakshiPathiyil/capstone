# What `gcloud run deploy --source .` leaves out of the upload. The image itself
# is filtered again by .dockerignore; this list keeps secrets and the heavy
# local folders from ever leaving the machine.
.gcloudignore
.git/
.github/

.env
app/api/.env

.venv/
**/.venv/
app/.venv/
app/.cache/
app/web/node_modules/
app/web/dist/
app/web/dist-e2e/
app/web/test-results/
app/web/playwright-report/

output/
*.safetensors
*.bin
*.pt
*.pth
*.zip
scenario_generation/fine_tuning/output/
scenario_generation/dataset/
scenario_generation/evaluation/

__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
