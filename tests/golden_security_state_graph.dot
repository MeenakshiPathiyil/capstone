digraph security_state_graph {
    // Security state graph: 15 resources, 16 edges, 21 findings, 7 entry points, 3 targets.
    // Render it with: dot -Tsvg output/security_state_graph.dot -o security_state_graph.svg
    // Diagram key in README.md. Arrows are the attacker's direction, so a network_control edge is labelled 'reversed'.
    //
    // Ranked attack paths, worst first (see output/attack_paths.json):
    //   AP-001  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> InsecureS3Bucket
    //   AP-002  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> PublicRDS
    //   AP-003  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> InsecureS3Bucket
    //   AP-004  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> PublicRDS
    //   AP-005  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> PublicRDS
    //   AP-006  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole
    //   AP-007  CRITICAL  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> InsecureS3Bucket
    //   AP-008  CRITICAL  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> PublicRDS
    //   AP-009  CRITICAL  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> InsecureS3Bucket
    //   AP-010  CRITICAL  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> PublicRDS
    //   AP-011  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> ReportsTable
    //   AP-012  CRITICAL  OpenSecurityGroup -> PublicEC2Instance -> OverPermissiveInstanceProfile -> OverPermissiveRole -> ReportsTable
    //   AP-013  CRITICAL  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> PublicRDS
    //   AP-014  CRITICAL  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole
    //   AP-015  HIGH  OpenSecurityGroup -> PublicEC2Instance
    //   AP-016  HIGH  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> ReportsTable
    //   AP-017  HIGH  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> OverPermissiveRole -> ReportsTable
    //   AP-018  HIGH  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole
    //   AP-019  HIGH  AppSecurityGroup -> AppServerInstance
    //   AP-020  MEDIUM  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole
    //   AP-021  MEDIUM  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> ReportsTable
    //   AP-022  MEDIUM  AppSecurityGroup -> AppServerInstance -> AppInstanceProfile -> AppServerRole -> DeploymentRole -> ReportsTable

    rankdir="LR";
    graph [fontname="Helvetica", fontsize="12"];
    node [style="filled", fontname="Helvetica", fontsize="14", fontcolor="#111827", penwidth="2"];
    edge [fontname="Helvetica", fontsize="11", fontcolor="#111827"];

    "n_AppInstanceProfile" [label="AppInstanceProfile\nAWS::IAM::InstanceProfile\nno findings", shape="box", fillcolor="#e5e7eb", color="#374151"];
    "n_AppSecurityGroup" [label="AppSecurityGroup\nAWS::EC2::SecurityGroup\nhigh\n[entry]", shape="house", fillcolor="#fbcfa4", color="#7c2d12"];
    "n_AppServerInstance" [label="AppServerInstance\nAWS::EC2::Instance\ncritical\n[entry]", shape="house", fillcolor="#f8b4b4", color="#7f1d1d"];
    "n_AppServerRole" [label="AppServerRole\nAWS::IAM::Role\nhigh", shape="box", fillcolor="#fbcfa4", color="#7c2d12"];
    "n_DeploymentRole" [label="DeploymentRole\nAWS::IAM::Role\ncritical", shape="box", fillcolor="#f8b4b4", color="#7f1d1d"];
    "n_IngestFunction" [label="IngestFunction\nAWS::Lambda::Function\nno findings", shape="box", fillcolor="#e5e7eb", color="#374151"];
    "n_InsecureS3Bucket" [label="InsecureS3Bucket\nAWS::S3::Bucket\nhigh\n[entry]", shape="house", fillcolor="#fbcfa4", color="#7c2d12"];
    "n_OpenLoadBalancer" [label="OpenLoadBalancer\nAWS::ElasticLoadBalancingV2::LoadBalancer\nhigh\n[entry]", shape="house", fillcolor="#fbcfa4", color="#7c2d12"];
    "n_OpenSecurityGroup" [label="OpenSecurityGroup\nAWS::EC2::SecurityGroup\nhigh\n[entry]", shape="house", fillcolor="#fbcfa4", color="#7c2d12"];
    "n_OverPermissiveInstanceProfile" [label="OverPermissiveInstanceProfile\nAWS::IAM::InstanceProfile\nno findings", shape="box", fillcolor="#e5e7eb", color="#374151"];
    "n_OverPermissiveRole" [label="OverPermissiveRole\nAWS::IAM::Role\ncritical", shape="box", fillcolor="#f8b4b4", color="#7f1d1d"];
    "n_PublicBucketPolicy" [label="PublicBucketPolicy\nAWS::S3::BucketPolicy\ncritical", shape="box", fillcolor="#f8b4b4", color="#7f1d1d"];
    "n_PublicEC2Instance" [label="PublicEC2Instance\nAWS::EC2::Instance\ncritical\n[entry]", shape="house", fillcolor="#f8b4b4", color="#7f1d1d"];
    "n_PublicRDS" [label="PublicRDS\nAWS::RDS::DBInstance\nhigh\n[entry]", shape="house", fillcolor="#fbcfa4", color="#7c2d12"];
    "n_ReportsTable" [label="ReportsTable\nAWS::DynamoDB::Table\nno findings", shape="box", fillcolor="#e5e7eb", color="#374151"];

    "n_AppInstanceProfile" -> "n_AppServerRole" [label="identity (AP-007, AP-008, AP-009, AP-010, AP-013, AP-014, AP-016, AP-017, AP-018, AP-020, AP-021, AP-022)", color="#b3261e", penwidth="4"];
    "n_AppSecurityGroup" -> "n_AppServerInstance" [label="network_control (reversed; AP-007, AP-008, AP-009, AP-010, AP-013, AP-014, AP-016, AP-017, AP-018, AP-019, AP-020, AP-021, AP-022)", color="#b3261e", penwidth="4"];
    "n_AppServerInstance" -> "n_AppInstanceProfile" [label="identity (AP-007, AP-008, AP-009, AP-010, AP-013, AP-014, AP-016, AP-017, AP-018, AP-020, AP-021, AP-022)", color="#b3261e", penwidth="4"];
    "n_AppServerRole" -> "n_DeploymentRole" [label="escalation + identity (AP-007, AP-008, AP-009, AP-010, AP-013, AP-014, AP-016, AP-017, AP-018, AP-021, AP-022)", color="#b3261e", penwidth="4"];
    "n_DeploymentRole" -> "n_AppServerRole" [label="escalation", color="#374151", penwidth="2"];
    "n_DeploymentRole" -> "n_OverPermissiveRole" [label="escalation (AP-007, AP-008, AP-009, AP-010, AP-013, AP-014, AP-016, AP-017)", color="#b3261e", penwidth="4"];
    "n_DeploymentRole" -> "n_ReportsTable" [label="capability (AP-021, AP-022)", color="#b3261e", penwidth="4"];
    "n_IngestFunction" -> "n_DeploymentRole" [label="trust", color="#374151", penwidth="2"];
    "n_OpenSecurityGroup" -> "n_PublicEC2Instance" [label="network_control (reversed; AP-001, AP-002, AP-003, AP-004, AP-005, AP-006, AP-011, AP-012, AP-015)", color="#b3261e", penwidth="4"];
    "n_OverPermissiveInstanceProfile" -> "n_OverPermissiveRole" [label="identity (AP-001, AP-002, AP-003, AP-004, AP-005, AP-006, AP-011, AP-012)", color="#b3261e", penwidth="4"];
    "n_OverPermissiveRole" -> "n_InsecureS3Bucket" [label="capability (AP-001, AP-003, AP-007, AP-009)", color="#b3261e", penwidth="4"];
    "n_OverPermissiveRole" -> "n_PublicRDS" [label="capability (AP-002, AP-004, AP-005, AP-008, AP-010, AP-013)", color="#b3261e", penwidth="4"];
    "n_OverPermissiveRole" -> "n_ReportsTable" [label="capability (AP-011, AP-012, AP-016, AP-017)", color="#b3261e", penwidth="4"];
    "n_PublicBucketPolicy" -> "n_InsecureS3Bucket" [label="connection", color="#374151", penwidth="2"];
    "n_PublicEC2Instance" -> "n_OverPermissiveInstanceProfile" [label="identity (AP-001, AP-002, AP-003, AP-004, AP-005, AP-006, AP-011, AP-012)", color="#b3261e", penwidth="4"];
}
