__pycache__/
.pytest_cache/

# Generated by the runners. Regenerated byte-identically on every run, so
# tracking them means every pipeline run dirties the tree and `git add -A`
# commits output. The golden copies under tests/ are the ones under review.
output/attack_paths.json
output/output_states.json
output/security_state_graph.json
output/security_state_graph.mmd
output/security_state_graph.dot
output/benchmark_baseline.json
data/infra_output.json
