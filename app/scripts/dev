#!/usr/bin/env bash
# Start the API (uvicorn, auto-reload) and the web app (Vite) together.
# Run it from anywhere. Ctrl-C stops both.
#
# API_PORT (default 8000) and WEB_PORT (default 5173) come from the environment.

set -u

usage() {
  cat <<'EOF'
Usage: app/scripts/dev [-h|--help]

Starts the API (uvicorn, auto-reload) and the web app (Vite). Ctrl-C stops both.

Environment:
  API_PORT   port for the API (default 8000)
  WEB_PORT   port for the Vite dev server (default 5173)

Example:
  API_PORT=8095 WEB_PORT=5195 app/scripts/dev
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "") ;;
  *)
    echo "dev: unknown argument: $1" >&2
    usage >&2
    exit 2
    ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
UVICORN="$ROOT/app/.venv/bin/uvicorn"
WEB="$ROOT/app/web"

API_PORT="${API_PORT:-8000}"
WEB_PORT="${WEB_PORT:-5173}"

for port in "$API_PORT" "$WEB_PORT"; do
  case "$port" in
    "" | *[!0-9]*)
      echo "dev: '$port' is not a port number." >&2
      exit 2
      ;;
  esac
done

if [ "$API_PORT" = "$WEB_PORT" ]; then
  echo "dev: API_PORT and WEB_PORT must differ." >&2
  exit 2
fi

if [ ! -x "$UVICORN" ]; then
  echo "dev: $UVICORN not found." >&2
  echo "Create the virtual environment first:" >&2
  echo "  python3.12 -m venv app/.venv" >&2
  echo "  app/.venv/bin/pip install -r app/api/requirements.txt -r app/api/requirements-test.txt" >&2
  exit 1
fi

if [ ! -d "$WEB/node_modules" ]; then
  echo "dev: $WEB/node_modules not found." >&2
  echo "Install the web dependencies first:" >&2
  echo "  (cd app/web && npm ci)" >&2
  exit 1
fi

for port in "$API_PORT" "$WEB_PORT"; do
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN > /dev/null 2>&1; then
    echo "dev: port $port is already in use. Stop the process using it and try again." >&2
    exit 1
  fi
done

# The proxy forwards the page's Origin, so the API must list the web port's
# origins. Set CAPSTONE_CORS_ORIGINS yourself (a JSON list) to override.
export CAPSTONE_CORS_ORIGINS="${CAPSTONE_CORS_ORIGINS:-[\"http://localhost:$WEB_PORT\",\"http://127.0.0.1:$WEB_PORT\"]}"

# Prefix every line of stdin with a label, colored when stdout is a terminal.
prefix() {
  if [ -t 1 ]; then
    awk -v p="$(printf '\033[%sm%s\033[0m' "$2" "$1")" '{ print p " " $0; fflush() }'
  else
    awk -v p="$1" '{ print p " " $0; fflush() }'
  fi
}

# Job control gives each service its own process group, so one signal reaches
# uvicorn's reload worker and the processes npm starts, and a terminal Ctrl-C
# reaches only this script. It is switched off again once both are started.
set -m

cd "$ROOT" || exit 1

"$UVICORN" app.api.main:app --host 127.0.0.1 --port "$API_PORT" --reload \
  --reload-dir app/api --reload-dir runner --reload-dir attack_path \
  --reload-dir engine --reload-dir parser --reload-dir security_state_graph \
  --reload-dir processing --reload-dir models --reload-dir data \
  < /dev/null > >(prefix "[api]" 36) 2>&1 &
API_PID=$!

(cd "$WEB" && VITE_API_PROXY="http://127.0.0.1:$API_PORT" exec npm run dev -- --host 127.0.0.1 --strictPort --port "$WEB_PORT") \
  < /dev/null > >(prefix "[web]" 35) 2>&1 &
WEB_PID=$!

set +m

group_alive() {
  kill -0 -- "-$1" 2> /dev/null
}

stop_all() {
  trap '' INT TERM
  echo "dev: stopping"

  kill -INT -- "-$API_PID" "-$WEB_PID" 2> /dev/null

  # Give both a few seconds to exit, then force it.
  for _ in $(seq 20); do
    group_alive "$API_PID" || group_alive "$WEB_PID" || return 0
    sleep 0.25
  done

  kill -KILL -- "-$API_PID" "-$WEB_PID" 2> /dev/null
}

trap 'stop_all; exit 130' INT TERM

echo "dev: API http://127.0.0.1:$API_PORT, web http://localhost:$WEB_PORT. Ctrl-C stops both."

# If either service exits on its own, stop the other and fail.
while kill -0 "$API_PID" 2> /dev/null && kill -0 "$WEB_PID" 2> /dev/null; do
  sleep 1
done

echo "dev: a service exited" >&2
stop_all
exit 1
